.container {
  padding: 20rpx;
  margin-bottom: 150rpx;
}

.progress {
  font-size: 28rpx;
  color: #f5a623;
  text-align: center;
  margin-bottom: 20rpx;
}

.question {
  font-size: 34rpx;
  margin: 30rpx 0;
  font-weight: bold;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  border: 2rpx solid #f5a623;
  padding: 20rpx;
  border-radius: 18rpx;
}

.option-selected {
  background: #ffe3ba;
  border-color: #ff8900;
}

.explain-box {
  margin-top: 40rpx;
  background: #fff7e5;
  border-left: 10rpx solid #ffa200;
  padding: 20rpx;
  border-radius: 12rpx;
}

.bottom-buttons {
  position: fixed;
  bottom: 40rpx;
  width: 100%;
  display: flex;
  justify-content: space-evenly;
  padding: 0 20rpx;
}

.btn-primary {
  background: #ffa800;
  color: #fff;
  padding: 20rpx 40rpx;
}

.btn-secondary {
  background: #ffd37a;
  color: #8a5500;
  padding: 20rpx 40rpx;
}

.btn-fav {
  background: #ffb14a;
  color: white;
}
